		  	 <article class="obj_article_details">

		
	<h1 class="page_title">
		Comparative Performance of Transformer Models for Cultural Heritage in NLP Tasks
	</h1>

	
	<div class="row">
		<div class="main_entry">

    <section class="item authors">
